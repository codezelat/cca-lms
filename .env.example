# ============================================================================
# Database - Supabase Postgres
# ============================================================================
# Get your connection string from Supabase Dashboard > Settings > Database
# Format: postgresql://postgres:[password]@[host]/[database]
# For better performance, use Supabase's pooler URL (port 6543)
# IMPORTANT: If your password contains special characters (!@#$%^&*?), URL-encode them
# Example: p@ssword → p%40ssword
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:6543/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"

# ============================================================================
# NextAuth Configuration
# ============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# Supabase (Optional)
# ============================================================================
# Only needed if using Supabase JS client for real-time, storage, or direct DB access
# This app uses Prisma ORM, so these are not required for basic functionality
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-publishable-key-here"
# SUPABASE_SECRET_KEY="your-secret-key-here"

# ============================================================================
# Cloudflare R2 (S3 Compatible Storage)
# ============================================================================
# Get these from Cloudflare Dashboard > R2 > Your Bucket
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_REGION="auto"

# For public URLs (using R2 custom domain or public bucket)
R2_PUBLIC_URL="https://your-custom-domain.com"

# ============================================================================
# Database Backups (App-Side Monitoring + Manual Trigger)
# ============================================================================
# The full backup job runs in GitHub Actions via .github/workflows/db-backup.yml
# Configure these in the deployed app so admins can monitor runs and trigger backups
# Use a fine-grained GitHub token with Actions read/write permission on the target repo
# If R2_PUBLIC_URL is used for course assets, point DB_BACKUP_BUCKET_NAME to a separate private bucket
GITHUB_BACKUP_REPOSITORY="your-org/your-repo"
GITHUB_BACKUP_WORKFLOW_FILE="db-backup.yml"
GITHUB_BACKUP_REF="main"
GITHUB_BACKUP_TOKEN="github_pat_your_token_here"
DB_BACKUP_BUCKET_NAME="your-private-db-backup-bucket"
DB_BACKUP_PREFIX="db-backups"
DB_BACKUP_RETENTION_DAYS="14"

# GitHub Actions repository secrets used by the backup workflow:
# SUPABASE_DB_URL must be a percent-encoded PostgreSQL connection string.
# A Supabase session pooler URL on port 5432 or a direct database URL both work.
# SUPABASE_DB_URL="postgresql://postgres:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres"
# BACKUP_APP_URL="https://your-production-domain.com"

# ============================================================================
# Backblaze B2 (Student Assignment Submissions Only)
# ============================================================================
# Get these from Backblaze B2 Dashboard > App Keys
# Bucket Name: cca-lms-student-submissions (or your chosen name)
# Settings: Private bucket, SSE-B2 encryption enabled
B2_APPLICATION_KEY_ID="your-b2-application-key-id"
B2_APPLICATION_KEY="your-b2-application-key"
B2_BUCKET_ID="your-b2-bucket-id"
B2_BUCKET_NAME="your-b2-bucket-name"
B2_ENDPOINT="https://s3.us-west-000.backblazeb2.com"  # Change region if needed

# ============================================================================
# Resend (Email Service)
# ============================================================================
# Get API key from https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV="development"
APP_NAME="Codezela Career Accelerator - LMS"
APP_URL="http://localhost:3000"

# ============================================================================
# Optional: OAuth Providers
# ============================================================================
# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================================================
# Cron Jobs Security
# ============================================================================
# Required for securing automated job callbacks from GitHub Actions and any Vercel cron jobs
# Generate with: openssl rand -base64 32
# GitHub Actions uses this as the Bearer token when reporting backup results
CRON_SECRET="your-cron-secret-here"

# Optional: Separate secret for admin API access (defaults to CRON_SECRET if not set)
# ADMIN_API_SECRET="your-admin-api-secret-here"
